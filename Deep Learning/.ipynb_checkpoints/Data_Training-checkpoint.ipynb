    "import time\n",
    "import pynvml\n",
    "\n",
    "pynvml.nvmlInit()\n",
    "\n",
    "def wait_for_free_gpu(max_util=60, max_temp=75):\n",
    "    \"\"\"\n",
    "    Pauses training if GPU utilization or temperature is too high.\n",
    "    \"\"\"\n",
    "    handle = pynvml.nvmlDeviceGetHandleByIndex(0)\n",
    "    util = pynvml.nvmlDeviceGetUtilizationRates(handle)\n",
    "    temp = pynvml.nvmlDeviceGetTemperature(handle, pynvml.NVML_TEMPERATURE_GPU)\n",
    "    \n",
    "    while util.gpu > max_util or temp > max_temp:\n",
    "        print(f\"⏸ GPU busy (util={util.gpu}%, temp={temp}°C). Waiting 2 minutes...\")\n",
    "        time.sleep(120)  # wait 2 minutes\n",
    "        util = pynvml.nvmlDeviceGetUtilizationRates(handle)\n",
    "        temp = pynvml.nvmlDeviceGetTemperature(handle, pynvml.NVML_TEMPERATURE_GPU)\n",
    "    \n",
    "    print(f\"✅ GPU free (util={util.gpu}%, temp={temp}°C). Resuming training...\")\n"
   ]
