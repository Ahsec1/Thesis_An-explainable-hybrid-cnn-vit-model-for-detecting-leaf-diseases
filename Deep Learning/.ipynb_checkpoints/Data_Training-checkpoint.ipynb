    "                    continue\n",
    "\n",
    "                full_class_name = f\"{crop_type}_{disease_class}\"\n",
    "                if full_class_name not in self.class_to_idx:\n",
    "                    self.class_to_idx[full_class_name] = class_idx\n",
    "                    class_idx += 1\n",
    "\n",
    "                for img_file in os.listdir(class_path):\n",
