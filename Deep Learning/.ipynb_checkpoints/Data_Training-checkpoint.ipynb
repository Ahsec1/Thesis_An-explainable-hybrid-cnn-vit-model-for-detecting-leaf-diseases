    "import torch\n",
    "import torch.nn.functional as F\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import numpy as np\n",
    "from sklearn.metrics import confusion_matrix, classification_report, accuracy_score\n",
    "from tqdm import tqdm  \n",
    "import os\n",
    "\n",
    "# ==========================================================\n",
    "# FUNCTION: Evaluate individual model on test set \n",
    "# ==========================================================\n",
    "def evaluate_single_model(model, test_loader, model_name=\"Model\"):\n",
    "    model.eval()\n",
    "    preds = []\n",
    "    targets = []\n",
    "    \n",
    "    with torch.no_grad():\n",
    "        for inputs, labels in tqdm(test_loader, desc=f\"🔍 Evaluating {model_name}\"):\n",
    "            inputs = inputs.to(device)\n",
    "            outputs = model(inputs)\n",
    "            preds.extend(torch.argmax(outputs, dim=1).cpu().numpy())\n",
    "            targets.extend(labels.numpy())\n",
    "    \n",
    "    return accuracy_score(targets, preds)\n",
    "\n",
    "# ==========================================================\n",
    "# LOAD BEST MODELS FOR ENSEMBLE\n",
    "# ==========================================================\n",
    "ensemble_models = {\n",
    "    'resnet50': get_resnet50(NUM_CLASSES).to(device),\n",
    "    'efficientnet_b0': get_efficientnet_b0(NUM_CLASSES).to(device),\n",
    "    'vit_small': get_vit_small(NUM_CLASSES).to(device)\n",
    "}\n",
    "\n",
    "for name, model in ensemble_models.items():\n",
    "    best_ckpt = os.path.join(CHECKPOINT_DIR, f\"{name}_best.pth\")\n",
    "    model.load_state_dict(torch.load(best_ckpt, map_location=device))\n",
    "    model.eval()\n",
    "    print(f\"✅ Loaded best weights for {name}\")\n",
    "\n",
    "# ==========================================================\n",
    "# ✅ Evaluate Individual Model Test Accuracies with progress bars\n",
    "# ==========================================================\n",
    "print(\"\\n📊 Evaluating Individual Models on Test Set...\")\n",
    "\n",
    "resnet_acc = evaluate_single_model(ensemble_models['resnet50'], test_loader, \"ResNet50\")\n",
    "effnet_acc = evaluate_single_model(ensemble_models['efficientnet_b0'], test_loader, \"EfficientNet-B0\")\n",
    "vit_acc = evaluate_single_model(ensemble_models['vit_small'], test_loader, \"ViT-Small\")\n",
    "\n",
    "print(f\"\\n✅ ResNet50 Test Accuracy: {resnet_acc:.4f}\")\n",
    "print(f\"✅ EfficientNet-B0 Test Accuracy: {effnet_acc:.4f}\")\n",
    "print(f\"✅ ViT-Small Test Accuracy: {vit_acc:.4f}\")\n",
    "\n",
    "# ==========================================================\n",
    "# 🟩 DEFINE ENSEMBLE WEIGHTS (Based on validation or test accuracy)\n",
    "# ==========================================================\n",
    "val_accuracies = {\n",
    "    'resnet50': resnet_acc,\n",
    "    'efficientnet_b0': effnet_acc,\n",
    "    'vit_small': vit_acc\n",
    "}\n",
    "\n",
    "# Normalize to ensure they sum to 1\n",
    "total = sum(val_accuracies.values())\n",
    "weights = {k: v / total for k, v in val_accuracies.items()}\n",
    "\n",
    "print(\"\\n📊 Ensemble Weights (Normalized):\")\n",
    "for k, v in weights.items():\n",
    "    print(f\"{k}: {v:.3f}\")\n",
    "\n",
    "# ==========================================================\n",
    "# ENSEMBLE PREDICTION ON TEST SET \n",
    "# ==========================================================\n",
    "all_preds = []\n",
    "all_targets = []\n",
    "\n",
    "with torch.no_grad():\n",
    "    for inputs, targets in tqdm(test_loader, desc=\"🔍 Evaluating Ensemble\"):\n",
    "        inputs = inputs.to(device)\n",
    "\n",
    "        weighted_sum = 0\n",
    "        for name, model in ensemble_models.items():\n",
    "            outputs = model(inputs)\n",
    "            probs = F.softmax(outputs, dim=1)\n",
    "            weighted_sum += weights[name] * probs\n",
    "\n",
    "        final_preds = torch.argmax(weighted_sum, dim=1)\n",
    "\n",
    "        all_preds.extend(final_preds.cpu().numpy())\n",
    "        all_targets.extend(targets.cpu().numpy())\n",
    "\n",
    "# ==========================================================\n",
    "# METRICS FOR ENSEMBLE\n",
    "# ==========================================================\n",
    "acc = accuracy_score(all_targets, all_preds)\n",
    "print(f\"\\n🎯 Ensemble Test Accuracy: {acc:.4f}\")\n",
    "print(\"\\n📌 Classification Report:\")\n",
    "print(classification_report(all_targets, all_preds, target_names=test_dataset.classes))\n",
    "\n",
    "# ==========================================================\n",
    "# ✅ PER-PLANT CONFUSION MATRICES\n",
    "# ==========================================================\n",
    "plant_groups = {\n",
    "    \"Coconut\": [i for i, c in enumerate(test_dataset.classes) if \"coconut\" in c.lower()],\n",
    "    \"Banana\": [i for i, c in enumerate(test_dataset.classes) if \"banana\" in c.lower()],\n",
    "    \"Sugarcane\": [i for i, c in enumerate(test_dataset.classes) if \"sugar\" in c.lower()]\n",
    "}\n",
    "\n",
    "print(\"\\n📌 Per-Plant Class Index Groups:\")\n",
    "for plant, idxs in plant_groups.items():\n",
    "    print(f\"{plant}: {[test_dataset.classes[i] for i in idxs]}\")\n",
    "\n",
    "# Convert for slice operations\n",
    "all_preds = np.array(all_preds)\n",
    "all_targets = np.array(all_targets)\n",
    "\n",
    "for plant, idxs in plant_groups.items():\n",
    "    mask = np.isin(all_targets, idxs)\n",
    "    plant_targets = all_targets[mask]\n",
    "    plant_preds = all_preds[mask]\n",
    "\n",
    "    index_mapping = {old: new for new, old in enumerate(idxs)}\n",
    "    plant_targets = np.array([index_mapping[i] for i in plant_targets])\n",
    "    plant_preds = np.array([index_mapping[i] for i in plant_preds])\n",
    "\n",
    "    plant_labels = [test_dataset.classes[i] for i in idxs]\n",
    "    cm_plant = confusion_matrix(plant_targets, plant_preds)\n",
    "\n",
    "    plt.figure(figsize=(10, 7))\n",
    "    sns.heatmap(cm_plant, annot=True, fmt=\"d\", cmap=\"Greens\",\n",
    "                xticklabels=plant_labels,\n",
    "                yticklabels=plant_labels)\n",
    "    plt.title(f\"{plant} Confusion Matrix - Ensemble\")\n",
    "    plt.xlabel(\"Predicted Labels\")\n",
    "    plt.ylabel(\"True Labels\")\n",
    "    plt.xticks(rotation=45, ha=\"right\")\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "# ==========================================================\n",
    "# OVERALL CONFUSION MATRIX\n",
    "# ==========================================================\n",
    "cm = confusion_matrix(all_targets, all_preds)\n",
    "plt.figure(figsize=(14, 10))\n",
    "sns.heatmap(cm, annot=True, fmt=\"d\", cmap=\"Blues\",\n",
    "            xticklabels=test_dataset.classes,\n",
    "            yticklabels=test_dataset.classes)\n",
    "plt.title(\"Confusion Matrix - Ensemble (Overall)\")\n",
    "plt.xlabel(\"Predicted\")\n",
    "plt.ylabel(\"True\")\n",
    "plt.xticks(rotation=45, ha=\"right\")\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# ==========================================================\n",
    "# ✅ MODEL ACCURACY COMPARISON BAR CHART\n",
    "# ==========================================================\n",
    "model_names = [\"ResNet50\", \"EfficientNet-B0\", \"ViT-Small\", \"Ensemble\"]\n",
    "model_accuracies = [resnet_acc, effnet_acc, vit_acc, acc]\n",
    "\n",
    "plt.figure(figsize=(8, 6))\n",
    "bars = plt.bar(model_names, model_accuracies)\n",
    "plt.ylabel(\"Accuracy\")\n",
    "plt.title(\"Model vs Ensemble Accuracy Comparison\")\n",
    "plt.ylim(0.75, 1.00)\n",
    "plt.grid(axis='y', linestyle=\"--\", linewidth=0.5)\n",
    "\n",
    "for bar in bars:\n",
    "    height = bar.get_height()\n",
    "    plt.text(bar.get_x() + bar.get_width()/2, height + 0.005,\n",
    "             f\"{height:.3f}\", ha='center', va='bottom')\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
  },
