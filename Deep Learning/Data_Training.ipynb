   "source": [
    "import shap\n",
    "import torch\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from torchvision import transforms\n",
    "from PIL import Image\n",
    "import cv2\n",
    "\n",
    "# ---\n",
    "# SHAP EXPLAINABILITY - WITH PROPER BACKGROUND SAMPLES\n",
    "# ---\n",
    "def shap_explainability(models, test_loader, test_dataset, num_samples=3):\n",
    "    \"\"\"\n",
    "    Generates SHAP visualizations for CNN and ViT models.\n",
    "    \"\"\"\n",
    "    device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "    \n",
    "    # ---\n",
    "    # Pick samples from test set - get more for background\n",
    "    # ---\n",
    "    batch = next(iter(test_loader))\n",
    "    inputs, labels = batch\n",
    "    inputs, labels = inputs.to(device), labels.to(device)\n",
    "    \n",
    "    # Use more samples for background, then analyze the rest\n",
    "    background_samples = 5  # Number of samples to use as background\n",
    "    analysis_samples = min(num_samples, inputs.size(0) - background_samples)\n",
    "    \n",
    "    background = inputs[:background_samples]\n",
    "    samples_to_analyze = inputs[background_samples:background_samples + analysis_samples]\n",
    "    labels_to_analyze = labels[background_samples:background_samples + analysis_samples]\n",
    "    \n",
    "    print(f\"📊 Using {background_samples} samples as background\")\n",
    "    print(f\"📊 Analyzing {analysis_samples} samples\")\n",
    "    \n",
    "    # ---\n",
    "    # Inverse normalization for visualization\n",
    "    # ---\n",
    "    transform_inv = transforms.Compose([\n",
    "        transforms.Normalize(mean=[-0.485/0.229, -0.456/0.224, -0.406/0.225], \n",
    "                           std=[1/0.229, 1/0.224, 1/0.225]),\n",
    "        transforms.ToPILImage()\n",
    "    ])\n",
    "    \n",
    "    # ---\n",
    "    # SHAP visualization helper\n",
    "    # ---\n",
    "    def visualize_shap(model, model_name, background_data, sample_data, sample_labels):\n",
    "        model.eval()\n",
    "        \n",
    "        print(f\"\\n🔍 Computing SHAP for {model_name}...\")\n",
    "        \n",
    "        try:\n",
    "            # Use GradientExplainer with proper background\n",
    "            explainer = shap.GradientExplainer(model, background_data)\n",
    "            \n",
    "            # Compute SHAP values\n",
    "            shap_values = explainer.shap_values(sample_data)\n",
    "            \n",
    "            # Compute predictions\n",
    "            with torch.no_grad():\n",
    "                predictions = model(sample_data)\n",
    "                pred_classes = predictions.argmax(dim=1).cpu().numpy()\n",
    "                pred_probs = torch.softmax(predictions, dim=1).cpu().numpy()\n",
    "            \n",
    "            print(f\"✅ SHAP computation successful for {model_name}\")\n",
    "            print(f\"SHAP values shape: {shap_values.shape}\")\n",
    "            \n",
    "            # Visualize each sample\n",
    "            for i in range(sample_data.size(0)):\n",
    "                img = transform_inv(sample_data[i].cpu())\n",
    "                true_label = sample_labels[i].item()\n",
    "                pred_class = pred_classes[i]\n",
    "                confidence = pred_probs[i][pred_class]\n",
    "                \n",
    "                # Get SHAP values for the predicted class\n",
    "                shap_for_pred_class = shap_values[i, :, :, :, pred_class]  # Shape: (3, 224, 224)\n",
    "                \n",
    "                print(f\"Sample {i+1} - True: {test_dataset.classes[true_label]}, Pred: {test_dataset.classes[pred_class]} (conf: {confidence:.3f})\")\n",
    "                print(f\"SHAP range: [{shap_for_pred_class.min():.6f}, {shap_for_pred_class.max():.6f}]\")\n",
    "                \n",
    "                # Create figure\n",
    "                plt.figure(figsize=(16, 4))\n",
    "                \n",
    "                # Plot 1: Original image\n",
    "                plt.subplot(1, 5, 1)\n",
    "                plt.imshow(img)\n",
    "                plt.title(f\"Original\\nTrue: {test_dataset.classes[true_label]}\", fontsize=9)\n",
    "                plt.axis('off')\n",
    "                \n",
    "                # Plot 2: SHAP heatmap (mean absolute across channels)\n",
    "                plt.subplot(1, 5, 2)\n",
    "                shap_abs = np.mean(np.abs(shap_for_pred_class), axis=0)\n",
    "                # Use fixed color scale for better comparison\n",
    "                vmax_abs = np.percentile(shap_abs, 99)  # Use 99th percentile to avoid outliers\n",
    "                im1 = plt.imshow(shap_abs, cmap='hot', vmin=0, vmax=vmax_abs)\n",
    "                plt.title(f\"SHAP |Importance|\\nvmax: {vmax_abs:.4f}\", fontsize=9)\n",
    "                plt.colorbar(im1, fraction=0.046, pad=0.04)\n",
    "                plt.axis('off')\n",
    "                \n",
    "                # Plot 3: Positive contributions only\n",
    "                plt.subplot(1, 5, 3)\n",
    "                shap_positive = np.mean(np.maximum(shap_for_pred_class, 0), axis=0)\n",
    "                vmax_pos = np.percentile(shap_positive, 99)\n",
    "                im2 = plt.imshow(shap_positive, cmap='Reds', vmin=0, vmax=vmax_pos)\n",
    "                plt.title(f\"Positive\\nvmax: {vmax_pos:.4f}\", fontsize=9)\n",
    "                plt.colorbar(im2, fraction=0.046, pad=0.04)\n",
    "                plt.axis('off')\n",
    "                \n",
    "                # Plot 4: Negative contributions only\n",
    "                plt.subplot(1, 5, 4)\n",
    "                shap_negative = np.mean(np.maximum(-shap_for_pred_class, 0), axis=0)\n",
    "                vmax_neg = np.percentile(shap_negative, 99) if shap_negative.max() > 0 else 1e-8\n",
    "                im3 = plt.imshow(shap_negative, cmap='Blues', vmin=0, vmax=vmax_neg)\n",
    "                plt.title(f\"Negative\\nvmax: {vmax_neg:.4f}\", fontsize=9)\n",
    "                plt.colorbar(im3, fraction=0.046, pad=0.04)\n",
    "                plt.axis('off')\n",
    "                \n",
    "                # Plot 5: Overlay\n",
    "                plt.subplot(1, 5, 5)\n",
    "                img_array = np.array(img)\n",
    "                \n",
    "                # Use absolute values for overlay\n",
    "                heatmap_resized = cv2.resize(shap_abs, (img_array.shape[1], img_array.shape[0]))\n",
    "                if heatmap_resized.max() > heatmap_resized.min():\n",
    "                    heatmap_resized = (heatmap_resized - heatmap_resized.min()) / (heatmap_resized.max() - heatmap_resized.min())\n",
    "                else:\n",
    "                    heatmap_resized = np.zeros_like(heatmap_resized)\n",
    "                \n",
    "                plt.imshow(img_array)\n",
    "                plt.imshow(heatmap_resized, cmap='hot', alpha=0.6)\n",
    "                plt.title(f\"Overlay\\nPred: {test_dataset.classes[pred_class]}\\nConf: {confidence:.3f}\", fontsize=9)\n",
    "                plt.axis('off')\n",
    "                \n",
    "                plt.tight_layout()\n",
    "                plt.show()\n",
    "                \n",
    "                # Print some statistics\n",
    "                print(f\"   SHAP stats - Min: {shap_for_pred_class.min():.6f}, Max: {shap_for_pred_class.max():.6f}, Mean: {shap_for_pred_class.mean():.6f}\")\n",
    "                print(f\"   Positive%: {(shap_for_pred_class > 0).mean():.3f}, Negative%: {(shap_for_pred_class < 0).mean():.3f}\")\n",
    "                \n",
    "        except Exception as e:\n",
    "            print(f\"❌ Error in SHAP for {model_name}: {e}\")\n",
    "            import traceback\n",
    "            traceback.print_exc()\n",
    "    \n",
