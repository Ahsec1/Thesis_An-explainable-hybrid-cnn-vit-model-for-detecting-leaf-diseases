    "import os\n",
    "import time\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "from torch.utils.data import DataLoader\n",
    "from torchvision import datasets, transforms, models\n",
    "from timm import create_model\n",
    "from tqdm.notebook import tqdm\n",
    "import pynvml\n",
    "\n",
    "# ==========================================================\n",
    "# CONFIGURATION\n",
    "# ==========================================================\n",
<<<<<<< Updated upstream
    "DATA_ROOT = r\"C:\\Users\\USER\\Documents\\Thesis Dataset\\Processed Dataset\"\n",
=======
    "DATA_ROOT = r\"C:\\Users\\Matthieu\\Downloads\\Thesis Dataset\\Thesis Dataset\\Processed Dataset\"\n",
