    "# ====== EXPLAINABILITY: GRAD-CAM + ViT ATTENTION ROLLOUT (UPDATED) ======\n",
    "import torch\n",
    "import torch.nn.functional as F\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import cv2\n",
    "from tqdm import tqdm\n",
    "from torchvision import transforms\n",
    "from PIL import Image\n",
    "\n",
    "# -----------------------\n",
    "# Grad-CAM class (kept compatible)\n",
    "# -----------------------\n",
    "class GradCAM:\n",
    "    def __init__(self, model, target_layer):\n",
    "        self.model = model\n",
    "        self.target_layer = target_layer\n",
    "        self.gradients = None\n",
    "        self.activations = None\n",
    "        self._register_hooks()\n",
    "\n",
    "    def _register_hooks(self):\n",
    "        def forward_hook(module, input, output):\n",
    "            self.activations = output.detach()\n",
    "\n",
    "        # newer PyTorch: use register_full_backward_hook when available; fallback to register_backward_hook\n",
    "        def backward_hook(module, grad_input, grad_output):\n",
    "            # grad_output[0] corresponds to activation's gradient\n",
    "            self.gradients = grad_output[0].detach()\n",
    "\n",
    "        self.target_layer.register_forward_hook(forward_hook)\n",
    "        try:\n",
    "            # preferred\n",
    "            self.target_layer.register_full_backward_hook(backward_hook)\n",
    "        except Exception:\n",
    "            # fallback (deprecated in newer versions but still works)\n",
    "            self.target_layer.register_backward_hook(backward_hook)\n",
    "\n",
    "    def generate(self, input_tensor, class_idx=None):\n",
    "        self.model.eval()\n",
    "        input_tensor = input_tensor.to(next(self.model.parameters()).device)\n",
    "        output = self.model(input_tensor)\n",
    "        if class_idx is None:\n",
    "            class_idx = torch.argmax(output, dim=1).item()\n",
    "\n",
    "        self.model.zero_grad()\n",
    "        class_score = output[0, class_idx]\n",
    "        class_score.backward(retain_graph=False)\n",
    "\n",
    "        # pooled gradients across spatial dims\n",
    "        pooled_grads = torch.mean(self.gradients, dim=[0, 2, 3])  # shape: [C]\n",
    "        # weight channels of activations\n",
    "        activations = self.activations.squeeze(0)                  # [C, H, W]\n",
    "        weighted = (pooled_grads.unsqueeze(1).unsqueeze(1) * activations).sum(dim=0)\n",
    "        heatmap = weighted.cpu().numpy()\n",
    "        heatmap = np.maximum(heatmap, 0)\n",
    "        if heatmap.max() > 0:\n",
    "            heatmap = heatmap / (heatmap.max() + 1e-8)\n",
    "        else:\n",
    "            heatmap = np.zeros_like(heatmap)\n",
    "        return heatmap\n",
    "\n",
    "# -----------------------\n",
    "# ViT Attention Rollout (robust qkv-based method for timm ViT)\n",
    "# -----------------------\n",
    "def compute_attention_rollout_vit_small(model, input_tensor):\n",
    "    \"\"\"\n",
    "    Compute attention rollout for timm ViT models by computing attention from qkv inside each block.attn.\n",
    "    Returns normalized 2D heatmap (H_patch x W_patch).\n",
    "    \"\"\"\n",
    "    model.eval()\n",
    "    device_model = next(model.parameters()).device\n",
    "\n",
    "    attn_matrices = []\n",
    "\n",
    "    # Hook function that computes attention matrix from qkv\n",
    "    def make_hook(block):\n",
    "        def hook(module, input, output):\n",
    "            # module is the attention module that contains qkv and num_heads/head_dim attributes\n",
    "            # input[0] is token embeddings shape [B, N, C]\n",
    "            x = input[0]  # token embeddings\n",
    "            # compute qkv using the module's qkv linear (some timm implementations store it as module.qkv)\n",
    "            if not hasattr(module, \"qkv\"):\n",
    "                return  # skip if no qkv (safety)\n",
    "            qkv = module.qkv(x)  # shape [B, N, 3*C]\n",
    "            B, N, _ = qkv.shape\n",
    "\n",
    "            # Some implementations store num_heads and head_dim; compute them\n",
    "            num_heads = getattr(module, \"num_heads\", None)\n",
    "            head_dim = getattr(module, \"head_dim\", None)\n",
    "\n",
    "            # if head info is missing, try to infer\n",
    "            C = qkv.shape[-1] // 3\n",
    "            if num_heads is None:\n",
    "                # try infer from module.scale or from model.default config; fallback to 8\n",
    "                num_heads = getattr(module, \"nhead\", None) or 8\n",
    "            if head_dim is None:\n",
    "                head_dim = C // num_heads\n",
    "\n",
    "            # reshape and split qkv\n",
    "            qkv_reshaped = qkv.reshape(B, N, 3, num_heads, head_dim)\n",
    "            qkv_reshaped = qkv_reshaped.permute(2, 0, 3, 1, 4)  # [3, B, heads, tokens, head_dim]\n",
    "            q, k, v = qkv_reshaped[0], qkv_reshaped[1], qkv_reshaped[2]\n",
    "\n",
    "            # compute scaled dot-product attention\n",
    "            attn = (q @ k.transpose(-2, -1)) * (1.0 / np.sqrt(head_dim))\n",
    "            attn = torch.softmax(attn, dim=-1)  # [B, heads, tokens, tokens]\n",
    "            attn_matrices.append(attn.detach().cpu())\n",
    "        return hook\n",
    "\n",
    "    hooks = []\n",
    "    # register hooks on each block.attn if present\n",
    "    for blk in getattr(model, \"blocks\", []):\n",
    "        if hasattr(blk, \"attn\"):\n",
    "            hooks.append(blk.attn.register_forward_hook(make_hook(blk)))\n",
    "\n",
    "    # forward pass\n",
    "    with torch.no_grad():\n",
    "        _ = model(input_tensor.to(device_model))\n",
    "\n",
    "    # remove hooks\n",
    "    for h in hooks:\n",
    "        h.remove()\n",
    "\n",
    "    if len(attn_matrices) == 0:\n",
    "        # fallback zero heatmap (14x14 for 224 with patch 16)\n",
    "        side = int((model.patch_embed.num_patches) ** 0.5) if hasattr(model, \"patch_embed\") else 14\n",
    "        return np.zeros((side, side))\n",
    "\n",
    "    # attn_matrices: list of tensors [B, heads, tokens, tokens] per layer\n",
    "    attn = torch.stack(attn_matrices)  # [layers, B, heads, tokens, tokens]\n",
    "    attn = attn.squeeze(1).mean(dim=1)  # -> [layers, tokens, tokens] averaged across heads (assumes B=1)\n",
    "\n",
    "    # add identity / residual connection and compute rollout\n",
    "    num_tokens = attn.size(-1)\n",
    "    result = torch.eye(num_tokens)\n",
    "    for layer_attn in attn:\n",
    "        # layer_attn shape [tokens, tokens]\n",
    "        a = layer_attn + torch.eye(num_tokens)\n",
    "        a = a / a.sum(dim=-1, keepdim=True)\n",
    "        result = a @ result\n",
    "\n",
    "    # take CLS token row -> attention to patches\n",
    "    mask = result[0, 1:]  # exclude CLS\n",
    "    side = int(mask.shape[0] ** 0.5)\n",
    "    mask = mask.reshape(side, side).numpy()\n",
    "    mask = (mask - mask.min()) / (mask.max() - mask.min() + 1e-8)\n",
    "    return mask\n",
    "\n",
    "# -----------------------\n",
    "# Utilities: overlay & find last conv\n",
    "# -----------------------\n",
    "def overlay_heatmap(img, heatmap):\n",
    "    # img: HxWx3 RGB (uint8 or float 0..1)\n",
    "    # heatmap: 2D array normalized 0..1\n",
    "    hmap_resized = cv2.resize(heatmap, (img.shape[1], img.shape[0]))\n",
    "    hmap_resized = np.clip(hmap_resized, 0, 1)\n",
    "    heatmap_color = cv2.applyColorMap(np.uint8(255 * hmap_resized), cv2.COLORMAP_JET)\n",
    "    # Convert input image to BGR for cv2.addWeighted then back to RGB for plt\n",
    "    if img.dtype != np.uint8:\n",
    "        base = (img * 255).astype(np.uint8)\n",
    "    else:\n",
    "        base = img.copy()\n",
    "    base_bgr = cv2.cvtColor(base, cv2.COLOR_RGB2BGR)\n",
    "    blended = cv2.addWeighted(base_bgr, 0.6, heatmap_color, 0.4, 0)\n",
    "    blended_rgb = cv2.cvtColor(blended, cv2.COLOR_BGR2RGB)\n",
    "    return blended_rgb\n",
    "\n",
    "def find_last_conv_layer(model):\n",
    "    for name, module in reversed(list(model.named_modules())):\n",
    "        if isinstance(module, torch.nn.Conv2d):\n",
    "            return module\n",
    "    raise ValueError(\"❌ No Conv2D layer found in model!\")\n",
    "\n",
    "# -----------------------\n",
    "# Visualization - show a few images with both Grad-CAMs and ViT rollout\n",
    "# -----------------------\n",
    "def visualize_explainability(models, sample_loader, test_dataset, num_samples=5):\n",
    "    # inverse normalization transform to display original images\n",
    "    transform_inv = transforms.Compose([\n",
    "        transforms.Normalize(mean=[-0.485/0.229, -0.456/0.224, -0.406/0.225],\n",
    "                             std=[1/0.229, 1/0.224, 1/0.225]),\n",
    "        transforms.ToPILImage()\n",
    "    ])\n",
    "\n",
    "    samples_shown = 0\n",
    "    gradcam_objects = {}\n",
    "\n",
    "    # Create one progress bar for total samples to show\n",
    "    pbar = tqdm(total=num_samples, desc=\"🔥 Generating Explainability Maps\", ncols=90)\n",
    "\n",
    "    for inputs, labels in sample_loader:\n",
    "        inputs = inputs.to(device)\n",
    "        labels = labels.to(device)\n",
    "        batch_size = inputs.size(0)\n",
    "\n",
    "        for i in range(batch_size):\n",
    "            if samples_shown >= num_samples:\n",
    "                pbar.close()\n",
    "                return\n",
    "\n",
    "            x = inputs[i].unsqueeze(0)\n",
    "            label = labels[i].item()\n",
    "\n",
    "            # recover image for display\n",
    "            img_pil = transform_inv(inputs[i].cpu())\n",
    "            img_np = np.array(img_pil)\n",
    "\n",
    "            # Prepare figure (1 row x 4 cols)\n",
    "            fig, axes = plt.subplots(1, 4, figsize=(20, 6))\n",
    "            axes[0].imshow(img_np)\n",
    "            axes[0].set_title(\"Original\")\n",
    "            axes[0].axis(\"off\")\n",
    "\n",
    "            # ---------- ResNet50 Grad-CAM ----------\n",
    "            try:\n",
    "                if 'resnet50' not in gradcam_objects:\n",
    "                    last_conv = find_last_conv_layer(models['resnet50'])\n",
    "                    gradcam_objects['resnet50'] = GradCAM(models['resnet50'], last_conv)\n",
    "                heatmap_rn = gradcam_objects['resnet50'].generate(x, class_idx=None)\n",
    "                axes[1].imshow(overlay_heatmap(img_np, heatmap_rn))\n",
    "                axes[1].set_title(\"ResNet50 (Grad-CAM)\")\n",
    "                axes[1].axis(\"off\")\n",
    "            except Exception as e:\n",
    "                axes[1].text(0.5, 0.5, f\"Error:\\n{e}\", ha='center')\n",
    "                axes[1].axis(\"off\")\n",
    "\n",
    "            # ---------- EfficientNet-B0 Grad-CAM ----------\n",
    "            try:\n",
    "                if 'efficientnet_b0' not in gradcam_objects:\n",
    "                    last_conv = find_last_conv_layer(models['efficientnet_b0'])\n",
    "                    gradcam_objects['efficientnet_b0'] = GradCAM(models['efficientnet_b0'], last_conv)\n",
    "                heatmap_eff = gradcam_objects['efficientnet_b0'].generate(x, class_idx=None)\n",
    "                axes[2].imshow(overlay_heatmap(img_np, heatmap_eff))\n",
    "                axes[2].set_title(\"EfficientNet-B0 (Grad-CAM)\")\n",
    "                axes[2].axis(\"off\")\n",
    "            except Exception as e:\n",
    "                axes[2].text(0.5, 0.5, f\"Error:\\n{e}\", ha='center')\n",
    "                axes[2].axis(\"off\")\n",
    "\n",
    "            # ---------- ViT-Small Attention Rollout ----------\n",
    "            try:\n",
    "                attn_map = compute_attention_rollout_vit_small(models['vit_small'], x)\n",
    "                axes[3].imshow(overlay_heatmap(img_np, attn_map))\n",
    "                axes[3].set_title(\"ViT-Small (Attention Rollout)\")\n",
    "                axes[3].axis(\"off\")\n",
    "            except Exception as e:\n",
    "                axes[3].text(0.5, 0.5, f\"Error:\\n{e}\", ha='center')\n",
    "                axes[3].axis(\"off\")\n",
    "\n",
    "            plt.suptitle(f\"True: {test_dataset.classes[label]}\", fontsize=14)\n",
    "            plt.tight_layout()\n",
    "            plt.show()\n",
    "\n",
    "            samples_shown += 1\n",
    "            pbar.update(1)\n",
    "\n",
    "    pbar.close()\n",
    "\n",
    "# -----------------------\n",
    "# Execute visualization (adjust num_samples if you'd like fewer/more)\n",
    "# -----------------------\n",
    "visualize_explainability(ensemble_models, test_loader, test_dataset, num_samples=5)\n"
   ]
